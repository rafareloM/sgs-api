# Proxy TLS local (spec 001, R1.1): HTTPS com certificado da CA interna do Caddy.
# A porta 80 só redireciona para HTTPS. O Caddy repassa X-Forwarded-For e X-Forwarded-Proto.
# Sem `trusted_proxies`, o Caddy descarta o X-Forwarded-For vindo do cliente e escreve o IP da
# conexão; a API só aceita esse cabeçalho do IP fixo do Caddy (spec 013, T4). Um balanceador
# antes do Caddy fica fora do escopo acadêmico: se houver, ele entra em `trusted_proxies`.
#
# Spec 012 (T1, R1.1 e R15.2): o front estático é servido no mesmo domínio da API.
# /api/*, /health/* e /.well-known/* vão para a API; o resto vem de /srv/frontend, com CSP.
localhost {
	tls internal

	@api path /api/* /health/* /.well-known/*
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/frontend
		header {
			# 'unsafe-inline' em style-src é exceção temporária (design da 012 § Entrega pelo Caddy).
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "no-referrer"
		}
		try_files {path} /index.html
		file_server
	}
}

# Spec 004 (design § Caddy e compose; D004-14): o Keycloak de laboratório num host próprio, na mesma
# porta. O Caddy confere o certificado do Keycloak pela CA de laboratório (volume servicos-certs,
# só ca/) e pelo nome `keycloak`. Sem cabeçalhos do front: as páginas são do Keycloak.
keycloak.localhost {
	tls internal

	reverse_proxy https://keycloak:8443 {
		transport http {
			tls_trust_pool file /certs-servicos/ca.crt
			tls_server_name keycloak
		}
	}
}

# Spec 005 (design § Ambiente de demonstração; D005-7): o S3 de laboratório num host próprio, na
# mesma porta, para o navegador baixar pela URL pré-assinada (R6.2). O `Host` original passa
# adiante (padrão do Caddy): a assinatura SigV4 da URL foi feita com ele. O Caddy confere o
# certificado do SeaweedFS pela CA de laboratório e pelo nome `s3`.
s3.localhost {
	tls internal

	reverse_proxy https://s3:8333 {
		transport http {
			tls_trust_pool file /certs-servicos/ca.crt
			tls_server_name s3
		}
	}
}
