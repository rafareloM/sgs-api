# Copie para .env e ajuste. Nunca commite o .env.
#
# Compose (spec 013, T4): estas duas vão em docker/.env (lido pelo `docker compose -f
# docker/compose.yml`) ou no ambiente. São obrigatórias. Cada stack no mesmo host precisa de uma
# subnet própria. O proxy usa o último endereço útil dela (.14 numa /28): o Docker dá os
# endereços dinâmicos de baixo para cima, e a API, criada antes, fica com o .2. O .1 é o gateway
# da bridge, que não é confiável.
# Faixa do projeto: 10.231.0.0/16 (as suítes e2e usam 10.231.10.0/28 a 10.231.15.0/28).
SGS_BORDA_SUBNET=10.231.1.0/28
SGS_BORDA_PROXY_IP=10.231.1.14

APP_ENV=dev
DEBUG=false
LOG_LEVEL=INFO
# Origens separadas por vírgula, no formato esquema://host[:porta]. Com OIDC, a origem de
# FRONTEND_URL tem de estar aqui (o front renova a sessão dali).
CORS_ORIGINS=https://localhost,https://localhost:3000

# A API conecta como sgs_api, membro do papel sgs_app (sem UPDATE/DELETE em audit_log).
DATABASE_URL=postgresql+asyncpg://sgs_api:sgs_api@db:5432/sgs
# Dono do banco, usado só pelas migrações (automáticas na subida em dev).
DATABASE_MIGRATION_URL=postgresql+asyncpg://sgs:sgs@db:5432/sgs
# disable | require | verify-full (prod exige verify-full; CA em DATABASE_SSL_ROOT_CERT).
# O compose já usa verify-full com a CA gerada pelo serviço db-certs (spec 011, R10.3).
DATABASE_SSL_MODE=verify-full
DATABASE_SSL_ROOT_CERT=/certs/ca.crt

# Chaves de assinatura JWT (ES256): lista JSON de objetos {"kid","pem"}; a primeira assina e
# todas vão para o JWKS. Gere com `uv run python -m src.tools.jwt_keys --output secrets/jwt-keys.json`.
# Aponte o arquivo em JWT_PRIVATE_KEYS_FILE ou ponha o JSON em JWT_PRIVATE_KEYS (só uma das duas).
# Em prod, kid com "troque", "exemplo", "example" ou "changeme" é recusado.
JWT_PRIVATE_KEYS_FILE=/run/secrets/jwt-keys.json

# Chaves de criptografia de campo (AES-256-GCM, segredo TOTP; spec 002, T5): objeto JSON
# {"versão":"32 bytes em base64"}. Gere com
# `uv run python -m src.tools.crypto_keys --output secrets/crypto-keys.json` e aponte o arquivo
# em CRYPTO_KEYS_FILE, ou ponha o JSON em CRYPTO_KEYS (só uma das duas). A chave de zeros abaixo
# é só de exemplo e é recusada em prod.
CRYPTO_KEYS_FILE=/run/secrets/crypto-keys.json
# CRYPTO_KEYS={"1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
CRYPTO_ACTIVE_KEY=1

# TOTP obrigatório para contas locais (spec 002). Só em dev pode ficar false, para testes manuais.
MFA_OBRIGATORIO=true

# Endereços públicos do compose (specs 004 e 005): alimentam ao mesmo tempo os serviços de
# laboratório e as variáveis OIDC_*, FRONTEND_URL e S3_PUBLIC_ENDPOINT_URL da API. Com
# SGS_HTTPS_PORT diferente de 443, levam a porta (por exemplo, https://localhost:8443,
# https://keycloak.localhost:8443 e https://s3.localhost:8443). Vão em docker/.env.
SGS_PUBLIC_URL=https://localhost
SGS_PUBLIC_KEYCLOAK_URL=https://keycloak.localhost
SGS_PUBLIC_S3_URL=https://s3.localhost

# LDAP (spec 004): valores do diretório de laboratório do compose, só por LDAPS, com a CA de
# laboratório. Sem LDAP_URL, o LDAP fica desligado. A senha de exemplo é recusada em prod (R5.4).
# No Active Directory: LDAP_USER_FILTER com a conta habilitada e os atributos sAMAccountName,
# mail, displayName, objectGUID e member (design da 004 § Configuração).
LDAP_URL=ldaps://ldap:636
LDAP_START_TLS=false
LDAP_CA_FILE=/certs-servicos/ca.crt
LDAP_BIND_DN=cn=sgs-sync,ou=servicos,dc=recife,dc=pe,dc=gov,dc=br
LDAP_BIND_PASSWORD=sgs-lab-exemplo-bind
LDAP_USER_BASE=ou=pessoas,dc=recife,dc=pe,dc=gov,dc=br
LDAP_USER_FILTER=(objectClass=inetOrgPerson)
LDAP_GROUP_BASE=ou=grupos,dc=recife,dc=pe,dc=gov,dc=br
LDAP_GROUP_FILTER=(objectClass=groupOfNames)
LDAP_ATTR_LOGIN=uid
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_NAME=cn
LDAP_ATTR_ID=entryUUID
LDAP_ATTR_MEMBER=member
# Opcional: sincronização agendada, no fuso de Recife (R1.12). Minuto e hora aceitam número, *,
# */n e lista a,b; dia, mês e dia da semana só *. Sem ela, só o disparo pela rota.
# LDAP_SYNC_CRON=30 2 * * *

# S3: spec 005, ainda não implementada (variáveis reservadas).

# OIDC (spec 004): valores do Keycloak de laboratório do compose. Sem OIDC_ISSUER, o OIDC fica
# desligado. O segredo de exemplo é recusado em prod (R5.4).
OIDC_ISSUER=https://keycloak.localhost/realms/sgs
# Descoberta, JWKS e token direto no Keycloak, pela rede interna, com a CA de laboratório.
OIDC_DISCOVERY_URL=https://keycloak:8443/realms/sgs/.well-known/openid-configuration
OIDC_CA_FILE=/certs-servicos/ca.crt
OIDC_CLIENT_ID=sgs-api
OIDC_CLIENT_SECRET=sgs-lab-exemplo-oidc
OIDC_REDIRECT_URI=https://localhost/api/v1/auth/oidc/callback
FRONTEND_URL=https://localhost/
OIDC_GROUPS_CLAIM=groups

# Exportação de relatórios (spec 005, design § Configuração): valores do SeaweedFS de
# laboratório do compose. Sem S3_BUCKET, a exportação fica desligada (503). Só https:// (R2.7).
# Em prod: S3_ASSUME_ROLE_ARN, S3_EXTERNAL_ID, S3_KMS_KEY_ID (ARN) e S3_SSE=aws:kms obrigatórios,
# e qualquer chave fixa (S3_ACCESS_KEY_ID, AWS_ACCESS_KEY_ID e afins) recusada (R2.9).
S3_BUCKET=sgs-relatorios
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://s3:8333
# Endereço das URLs de download, o que o navegador alcança (R3.6). Padrão: S3_ENDPOINT_URL.
S3_PUBLIC_ENDPOINT_URL=https://s3.localhost
S3_CA_FILE=/certs-servicos/ca.crt
S3_ADDRESSING_STYLE=path
S3_ASSUME_ROLE_ARN=
S3_EXTERNAL_ID=
S3_KMS_KEY_ID=
S3_SSE=AES256
# Chaves fixas só do laboratório; recusadas em prod.
S3_ACCESS_KEY_ID=sgs-lab-exemplo
S3_SECRET_ACCESS_KEY=sgs-lab-exemplo-s3
# Chave de assinatura dos relatórios (R5), gerada como no README; nunca a mesma das JWT.
REPORT_SIGNING_KEYS_FILE=/run/secrets/report-keys.json
REPORT_RETENTION_DAYS=90
